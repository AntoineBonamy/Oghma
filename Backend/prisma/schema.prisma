// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

////////////////////
// ENUMS
////////////////////

enum WorldRole {
  MJ
  PLAYER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  DECLINED
}

enum SessionStatus {
  OPEN // Session en cours
  CLOSED // Session terminée
}

enum SessionEventType {
  DICE_ROLL // Jet de dé
  MESSAGE // Chat
  COMBAT // Combat
}

////////////////////
// MODELS
////////////////////

model User {
  id           String @id @default(uuid())
  email        String @unique
  username     String
  passwordHash String

  worldsOwned World[]       @relation("WorldOwner")
  memberships WorldMember[]
  characters  Character[]
  diceRolls   DiceRoll[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens       RefreshToken[]
  sessionParticipants SessionParticipant[]
  sessionEvents       SessionEvent[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model World {
  id          String  @id @default(uuid())
  name        String
  description String?

  ownerId String
  owner   User   @relation("WorldOwner", fields: [ownerId], references: [id])

  members     WorldMember[]
  campaigns   Campaign[]
  characters  Character[]
  invitations Invitation[]
  diceRolls   DiceRoll[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model WorldMember {
  id String @id @default(uuid())

  worldId String
  userId  String
  role    WorldRole

  world World @relation(fields: [worldId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  joinedAt DateTime @default(now())

  @@unique([worldId, userId])
}

model Campaign {
  id String @id @default(uuid())

  worldId String
  world   World  @relation(fields: [worldId], references: [id])

  name        String
  description String?
  isActive    Boolean @default(false)

  sessions GameSession[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Character {
  id String @id @default(uuid())

  userId  String
  worldId String?

  name String

  isTemplate Boolean @default(true)

  parentCharacterID String?
  parentCharacter   Character?  @relation("CharacterCopies", fields: [parentCharacterID], references: [id])
  copies            Character[] @relation("CharacterCopies")

  user  User   @relation(fields: [userId], references: [id])
  world World? @relation(fields: [worldId], references: [id])

  diceRolls DiceRoll[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Invitation {
  id String @id @default(uuid())

  worldId String
  world   World  @relation(fields: [worldId], references: [id])

  email  String
  code   String           @unique
  role   WorldRole        @default(PLAYER)
  status InvitationStatus @default(PENDING)

  createdAt DateTime @default(now())
  expiresAt DateTime
}

model DiceRoll {
  id String @id @default(uuid())

  worldId     String
  userId      String
  characterId String?
  sessionId   String?

  diceType String
  result   Int

  world     World        @relation(fields: [worldId], references: [id])
  user      User         @relation(fields: [userId], references: [id])
  character Character?   @relation(fields: [characterId], references: [id])
  session   GameSession? @relation(fields: [sessionId], references: [id])

  createdAt DateTime @default(now())
}

model GameSession {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])

  sessionStatus  SessionStatus @default(OPEN)
  openedAt DateTime      @default(now())
  closedAt DateTime?

  participants SessionParticipant[]
  events       SessionEvent[]
  diceRolls    DiceRoll[] // accès direct aux lancers de cette session

  @@index([campaignId]) // on cherchera souvent "sessions de cette campagne"
}

model SessionParticipant {
  id        String      @id @default(uuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id])
  userId    String
  user      User        @relation(fields: [userId], references: [id])

  joinedAt DateTime  @default(now())
  leftAt   DateTime? // null = encore connecté

  @@unique([sessionId, userId]) // un joueur ne peut être dans la session qu'une fois
}

model SessionEvent {
  id        String      @id @default(uuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id])
  userId    String
  user      User        @relation(fields: [userId], references: [id])

  type    SessionEventType
  payload Json // { diceType: "d20", result: 17, characterName: "Aragorn" }

  createdAt DateTime @default(now())

  @@index([sessionId]) // on récupère souvent tous les events d'une session
}
